# Copy these values into the environment used by PHP/Apache.
# Do not commit real credentials.
DB_HOST=127.0.0.1
DB_NAME=vorta_prodtracker
DB_USER=vorta_app
DB_PASS=replace-with-a-strong-password
APP_URL=http://127.0.0.1:8000

# Required only when running the optional sample seeders.
SEED_DEFAULT_PASSWORD=replace-with-a-unique-password-at-least-12-chars
MAIL_FROM_EMAIL=verified-sender@example.com
MAIL_FROM_NAME=Vorta Prodtracker
